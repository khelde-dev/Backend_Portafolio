{
	"name": "backend-portafolio",
	"type": "module",
	"version": "0.8.0",
	"engines": {
		"bun": ">=1.3.0"
	},
	"scripts": {
		"dev": "wrangler dev",
		"deploy": "wrangler deploy",
		"db:generate": "drizzle-kit generate",
		"db:migrate:local": "wrangler d1 migrations apply DB --local",
		"db:migrate:remote": "wrangler d1 migrations apply DB --remote",
		"db:import-turso": "bun run scripts/build-d1-import.ts",
		"backup:turso": "bun run scripts/backup-turso.ts",
		"types": "wrangler types",
		"format": "bunx biome format --write ./src ./tests ./scripts",
		"lint": "bunx biome lint --write ./src ./tests ./scripts",
		"check": "bunx biome check --write ./src ./tests ./scripts",
		"typecheck": "tsc --noEmit",
		"test": "bun run test:unit && bun run test:integration",
		"test:unit": "bun test --preload ./tests/support/setup.ts tests/unit tests/security tests/property",
		"test:security": "bun test --preload ./tests/support/setup.ts tests/security",
		"test:property": "bun test --preload ./tests/support/setup.ts tests/property",
		"test:integration": "bun test tests/integration",
		"test:coverage": "bun test --preload ./tests/support/setup.ts --coverage tests/unit tests/security tests/property",
		"prepare": "husky",
		"smoke:d1": "bun run scripts/smoke-d1.ts",
		"lint:ci": "biome ci ./src ./tests ./scripts",
		"build:check": "wrangler deploy --dry-run --outdir .wrangler/dry-run",
		"db:drift": "drizzle-kit generate && git diff --exit-code -- drizzle",
		"audit": "bun audit --audit-level=high",
		"ci": "bun run lint:ci && bun run typecheck && bun run test:coverage && bun run test:integration && bun run build:check"
	},
	"dependencies": {
		"@hono/zod-validator": "^0.9.1",
		"drizzle-orm": "^0.45.2",
		"drizzle-zod": "^0.8.3",
		"hono": "^4.13.7",
		"husky": "9.1.7",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "2.2.3",
		"@cloudflare/workers-types": "^5.20261102.1",
		"@libsql/client": "^0.18.0",
		"@types/bun": "^1.4.2",
		"@types/node": "^20.11.17",
		"drizzle-kit": "^0.31.10",
		"fast-check": "^4.10.2",
		"typescript": "^5.8.3",
		"wrangler": "^4.156.1"
	},
	"overrides": {
		"ws": ">=8.20.1"
	}
}
